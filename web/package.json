{
  "name": "dsc-web",
  "version": "0.1.0",
  "private": true,
  "description": "Damn Simple Cooking — the recipe site (Next.js App Router, server-rendered, Firebase Auth + Firestore).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
